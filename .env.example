# Copy to .env for local production builds. Do not commit .env.
# These values are public in the HTML. Prefer GitHub Actions repository
# variables on the deploy workflow (see README) over committing them.

# Site origin, no path and no trailing slash. Default: https://willcraig.github.io
# PUBLIC_SITE_ORIGIN=https://willcraig.github.io

# Project base path is BASE_PATH, read by svelte.config.js from the shell
# (not from this file). Default: /loopr. Use an empty value for a host-root domain:
#   BASE_PATH= pnpm build

# Analytics is off until one provider is set. Placeholders are ignored.
# Set PUBLIC_ANALYTICS_PROVIDER when more than one of the blocks below is filled in.
# PUBLIC_ANALYTICS_PROVIDER=goatcounter

# GoatCounter → Settings → Sites → the count endpoint.
# PUBLIC_GOATCOUNTER_ENDPOINT=https://YOUR_CODE.goatcounter.com/count

# Plausible. PUBLIC_PLAUSIBLE_SCRIPT overrides the hosted script for a self-hosted instance.
# PUBLIC_PLAUSIBLE_DOMAIN=YOUR_DOMAIN
# PUBLIC_PLAUSIBLE_SCRIPT=https://plausible.io/js/script.js

# Cloudflare Web Analytics → beacon token (public; it ships in the page).
# PUBLIC_CF_BEACON_TOKEN=YOUR_CLOUDFLARE_WEB_ANALYTICS_TOKEN
